generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  utilisateur
  administrateur
}

model Utilisateur {
  id             Int      @id @default(autoincrement())
  nomUtilisateur String
  email          String   @unique
  password       String
  role           Role     @default(utilisateur)  // Utilisation de l'enum Role
  taches         Tache[]  // Relation avec les tâches
  provider       String?  // Optionnel : méthode d'authentification (ex: google, github)
}

model Tache {
  id           Int        @id @default(autoincrement())
  titre        String
  description  String
  dateEcheance DateTime?
  priorite     String
  statut       String
  estPrive     Boolean    @default(false)
  bloquee      Boolean    @default(false)
  userId       Int
  utilisateur  Utilisateur @relation(fields: [userId], references: [id])
}
