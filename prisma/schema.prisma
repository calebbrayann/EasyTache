generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// ─────────────── ENUMS ───────────────
enum Role {
  utilisateur
  administrateur
}

enum Priorite {
  basse
  moyenne
  haute
}

enum Statut {
  en_cours
  terminé
  bloqué
}

model Log {
  id        String   @id @default(uuid())
  email     String
  type      LogType
  timestamp DateTime @default(now())
}

enum LogType {
  login
  logout
}


// ─────────────── MODELS ───────────────
model Utilisateur {
  id             Int       @id @default(autoincrement())
  nomUtilisateur String
  email          String    @unique
  password       String
  role           Role      @default(utilisateur)
  provider       String?   // "google", "github", etc.
  joinDate       DateTime  @default(now())
  isActive       Boolean   @default(true)

  // Champs pour réinitialisation de mot de passe
  resetToken     String?   @unique
  resetTokenExp  DateTime?

  // Relation avec les tâches
  taches         Tache[]
}

model Tache {
  id           Int          @id @default(autoincrement())
  titre        String
  description  String
  dateEcheance DateTime?
  priorite     Priorite
  statut       Statut
  estPrive     Boolean      @default(false)
  bloquee      Boolean      @default(false)

  // Clé étrangère
  userId       Int
  utilisateur  Utilisateur  @relation(fields: [userId], references: [id])
}